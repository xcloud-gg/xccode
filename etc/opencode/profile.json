{
  "$schema": "https://opencode.ai/config.json",
  "model": "xc/auto",
  "providers": {
    "xc": {
      "name": "xcroute",
      "env": ["XCC_TOKEN"],
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": { "baseURL": "http://127.0.0.1:18080/v1" },
      "models": { "auto": { "modelID": "xc/auto", "name": "xc/auto" } }
    }
  },
  "mcp": {
    "servers": {
      "xccode-mcp": {
        "type": "local",
        "command": ["/opt/xcloud/xccode/venv/bin/xccode", "mcp"]
      }
    }
  },
  "plugins": ["@mohak34/opencode-notifier"],
  "instructions": ["/opt/xcloud/xccode/opencode-plugins/shell_strategy.md"],
  "skills": ["/opt/xcloud/xccode/skills/approved"]
}
