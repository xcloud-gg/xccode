# xccode — vendor API keys you provide. Put values after the '='.
# Copy to OPERATOR-KEYS.env (gitignored) and fill in. The xcroute agent tokens
# are generated automatically — not in this file.
#
# Default pools route through OpenCode Zen; only OPENCODE_API_KEY is required
# for model calls. ANTHROPIC_API_KEY is reserved for the P3 advisor.

OPENCODE_API_KEY=
ANTHROPIC_API_KEY=
