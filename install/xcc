#!/bin/sh
# xcc — launch OpenCode with xccode's own config directory (XC-CODE-001 §4.1).
# For marius only. Installed by install.sh as a wrapper; never piped into a shell.
set -eu

# OpenCode is installed at the pinned release and put on PATH; override for tests.
OPENCODE_BIN="${XCCODE_OPENCODE:-opencode}"

# xccode keeps its OpenCode state separate from any other OpenCode on the host, and never
# self-updates (pins are owned by the release, XC-CODE-001 §11).
export OPENCODE_CONFIG_DIR="${OPENCODE_CONFIG_DIR:-$HOME/.config/xccode/opencode}"
export OPENCODE_CONFIG="${OPENCODE_CONFIG:-$HOME/.config/xccode/opencode/opencode.json}"
export OPENCODE_DISABLE_AUTOUPDATE="${OPENCODE_DISABLE_AUTOUPDATE:-1}"
# OpenCode v2 installs npm plugins with bun (§4.3); put the pinned runtime on PATH.
export PATH="/opt/xcloud/xccode/bun/bun-linux-x64:${PATH}"

# Refuse to start inside a repository marked secret: xccode has no local model for SECRET work
# (XC-CODE-001 §13), so a marked tree must never reach a cloud provider. Both the working directory
# and any project-directory argument are checked, with symlinks resolved (pwd -P).
reject_secret() {
    _dir=$1
    while true; do
        if [ -e "$_dir/.xccode-secret" ]; then
            echo "xcc: refusing to start inside a repository marked .xccode-secret" >&2
            echo "xcc: xccode has no local model for SECRET work; use a different tool here" >&2
            exit 1
        fi
        [ "$_dir" = "/" ] && break
        _dir=$(dirname "$_dir")
    done
}

reject_secret "$(pwd -P)"
for _arg in "$@"; do
    case "$_arg" in
        -*) continue ;;
    esac
    if [ -d "$_arg" ]; then
        _resolved=$(cd "$_arg" && pwd -P) || continue
        reject_secret "$_resolved"
    fi
done

exec "$OPENCODE_BIN" "$@"
