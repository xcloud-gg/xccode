[Unit]
Description=xccode routing hub (xcroute)
After=network.target

[Service]
Type=exec
User=xccode
Group=xccode
ExecStart=/opt/xcloud/xccode/venv/bin/xccode serve --config /etc/xcloud/xccode/serve.toml --host 127.0.0.1 --port 18080
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
