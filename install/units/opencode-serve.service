[Unit]
# xccode opencode serve: the operator's persistent opencode.nvim backend (XC-CODE-001 §4.3).
# A marius USER unit (not system): it lives with the desktop session and talks only to loopback.
Description=xccode opencode serve (opencode.nvim backend, 127.0.0.1:18090)

[Service]
# Hardening per spec §4.3: bind loopback only, authenticate with a password, never --mdns
# (which forces 0.0.0.0). The password is a generated 0600 operator-only file
# (~/.config/xccode/serve.pass, written by install.sh step_serve): systemd's LoadCredential* on
# user units needs key-backed machinery that is unreliable headless (243/CREDENTIALS on thor);
# a private file read by ExecStart gives the same confidentiality without it.
ExecStart=/bin/sh -ec 'OPENCODE_SERVER_PASSWORD="$(cat "$HOME/.config/xccode/serve.pass")" PATH="/home/marius/.local/bin:$PATH" exec xcc serve --hostname 127.0.0.1 --port 18090'
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
