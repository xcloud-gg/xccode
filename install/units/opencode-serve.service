[Unit]
# xccode opencode serve: the operator's persistent opencode.nvim backend (XC-CODE-001 §4.3).
# A marius USER unit (not system): it lives with the desktop session and talks only to loopback.
Description=xccode opencode serve (opencode.nvim backend, 127.0.0.1:18090)

[Service]
# Hardening per spec §4.3: bind loopback only, authenticate with a password, never --mdns
# (which forces 0.0.0.0). The password arrives as a user credential written by the installer
# (root-only host credential dir), never in the unit and never in the repo.
LoadCredentialEncrypted=opencode-serve
ExecStart=/bin/sh -ec 'OPENCODE_SERVER_PASSWORD="$(cat "$CREDENTIALS_DIRECTORY/opencode-serve")" PATH="/home/marius/.local/bin:$PATH" exec xcc serve --hostname 127.0.0.1 --port 18090'
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
